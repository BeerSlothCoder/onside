{
  "manifest_version": 3,
  "name": "Onside — Prediction markets, played live",
  "version": "0.1.0",
  "description": "In-play micro-markets over any live football stream, settled trustlessly on Solana from TxLINE-verified match data.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.ceskatelevize.cz/*",
    "https://*.nova.cz/*",
    "https://*.tipsport.cz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://*.ceskatelevize.cz/*",
        "https://*.nova.cz/*",
        "https://*.tipsport.cz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Onside"
  }
}